generator postgresClient {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/postgres"
}

datasource postgres {
  provider = "postgresql"
  url      = env("DATABASE_URL_POSTGRES")
  schemas  = ["tenant", "inventory", "product", "shipping", "pricing", "sales", "customer", "common", "geography"]
}

// Tenant schema models
model Tenant {
  id                       String        @id
  name                     String
  authIdentityId           String        @unique
  defaultStoreId           String?       @unique
  defaultPhoneNumberId     String?       @unique
  defaultShippingAddressId String?       @unique
  defaultBillingAddressId  String?       @unique
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  authIdentity             AuthIdentity  @relation("TenantAuth", fields: [authIdentityId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  stores                   Store[]       @relation("TenantStores")
  phoneNumbers             PhoneNumber[]
  addresses                Address[]
  defaultStore             Store?        @relation("TenantDefaultStore", fields: [defaultStoreId, id], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  defaultPhoneNumber       PhoneNumber?  @relation("TenantDefaultPhone", fields: [defaultPhoneNumberId, id], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  defaultShippingAddress   Address?      @relation("TenantDefaultShippingAddress", fields: [defaultShippingAddressId, id], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  defaultBillingAddress    Address?      @relation("TenantDefaultBillingAddress", fields: [defaultBillingAddressId, id], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([defaultStoreId, id])
  @@unique([defaultPhoneNumberId, id])
  @@unique([defaultShippingAddressId, id])
  @@unique([defaultBillingAddressId, id])
  @@schema("tenant")
}

model Store {
  id                     String                  @id
  tenantId               String
  name                   String?
  domain                 String?                 @unique
  logo                   String?
  description            String?                 @postgres.Text
  currency               Currency
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  tenant                 Tenant                  @relation("TenantStores", fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  defaultForTenant       Tenant?                 @relation("TenantDefaultStore")
  subscription           Subscription?
  roles                  EmployeeRole[]
  employees              Employee[]
  roleFeatures           RoleFeatures[]
  warehouses             Warehouse[]
  stockMovements         StockMovement[]
  stockPerWarehouses     StockPerWarehouse[]
  shippingRules          ShippingRule[]
  shippmentRates         ShipmentRate[]
  taxRates               TaxRate[]
  categories             Category[]
  productCategories      ProductCategories[]
  products               Product[]
  media                  Media[]
  variants               Variant[]
  promotions             Promotion[]
  coupons                Coupon[]
  couponUsages           CouponUsage[]
  cartPromotions         CartPromotions[]
  orderPromotions        OrderPromotions[]
  carts                  Cart[]
  cartItems              CartItem[]
  orders                 Order[]
  orderDetails           OrderDetail[]
  returns                Return[]
  payments               Payment[]
  paymentMethods         PaymentMethod[]
  customers              Customer[]
  wishLists              WishList[]
  customerReviewProducts CustomerReviewProduct[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@schema("tenant")
}

