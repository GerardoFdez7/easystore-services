model Subscription {
  id        String             @id
  status    SubscriptionStatus
  startDate DateTime
  endDate   DateTime
  planId    String
  storeId   String             @unique
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  store     Store              @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  Plan      Plan               @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  payments  Payment[]

  @@unique([id, storeId])
  @@index([planId])
  @@schema("tenant")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED

  @@schema("tenant")
}

model Plan {
  id           String         @id
  name         String         @unique @postgres.Citext
  description  String
  price        Decimal
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  subscription Subscription[]

  @@schema("tenant")
}

model Employee {
  id             String          @id
  name           String          @postgres.Citext
  roleId         String
  authIdentityId String          @unique
  storeId        String
  role           EmployeeRole    @relation(fields: [roleId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Cascade)
  authIdentity   AuthIdentity    @relation("EmployeeAuth", fields: [authIdentityId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  store          Store           @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  StockMovement  StockMovement[]

  @@unique([id, storeId])
  @@index([roleId])
  @@index([storeId])
  @@schema("tenant")
}

model EmployeeRole {
  id           String         @id
  role         String
  isSystem     Boolean        @default(false)
  storeId      String
  store        Store          @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  employees    Employee[]
  roleFeatures RoleFeatures[]

  @@unique([storeId, role])
  @@unique([id, storeId])
  @@index([storeId])
  @@schema("tenant")
}

model RoleFeatures {
  id           String           @id
  roleId       String
  featureId    String
  action       PermissionAction
  storeId      String
  employeeRole EmployeeRole     @relation(fields: [roleId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  feature      Feature          @relation(fields: [featureId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  store        Store            @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([roleId, featureId, action])
  @@index([roleId])
  @@index([featureId])
  @@index([storeId])
  @@schema("tenant")
}

enum PermissionAction {
  VIEW
  CREATE
  EDIT
  DELETE

  @@schema("tenant")
}

model Feature {
  id           String         @id
  code         String         @unique
  name         String         @postgres.Citext
  description  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  roleFeatures RoleFeatures[]

  @@schema("tenant")
}

// Inventory schema models
model Warehouse {
  id                 String              @id
  name               String              @postgres.Citext
  addressId          String
  storeId            String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  store              Store               @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  address            Address             @relation(fields: [addressId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  stockMovements     StockMovement[]
  stockPerWarehouses StockPerWarehouse[]

  @@unique([id, storeId])
  @@unique([storeId, name])
  @@unique([storeId, addressId])
  @@index([addressId])
  @@schema("inventory")
}

model StockMovement {
  id                  String            @id
  deltaQty            Int
  reason              String            @postgres.Text
  createdById         String?
  warehouseId         String
  stockPerWarehouseId String
  storeId             String
  occurredAt          DateTime          @default(now())
  warehouse           Warehouse         @relation(fields: [warehouseId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  createdBy           Employee?         @relation(fields: [createdById, storeId], references: [id, storeId], onDelete: SetNull, onUpdate: Cascade)
  StockPerWarehouse   StockPerWarehouse @relation(fields: [stockPerWarehouseId, storeId], references: [id, storeId])
  store               Store             @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([createdById])
  @@index([warehouseId])
  @@index([stockPerWarehouseId])
  @@index([storeId])
  @@schema("inventory")
}

model StockPerWarehouse {
  id                         String          @id
  qtyAvailable               Int             @default(0)
  qtyReserved                Int             @default(0)
  productLocation            String?
  estimatedReplenishmentDate DateTime?
  lotNumber                  String?
  serialNumbers              String[]
  variantId                  String
  warehouseId                String
  storeId                    String
  deletedAt                  DateTime?
  stockMovements             StockMovement[]
  variant                    Variant         @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  warehouse                  Warehouse       @relation(fields: [warehouseId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  store                      Store           @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([warehouseId, variantId, storeId])
  @@unique([id, storeId])
  @@index([variantId])
  @@index([storeId])
  @@schema("inventory")
}

// Shipping schema models
model ShippingRule {
  id             String           @id
  type           ShippingRuleType
  slug           String
  description    String
  isEnabled      Boolean          @default(true)
  priority       Int?
  conditions     Json?
  storeId        String
  variantId      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  shippmentRates ShipmentRate[]
  store          Store            @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  variant        Variant?         @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)

  @@unique([storeId, slug])
  @@unique([storeId, priority])
  @@unique([id, storeId])
  @@index([storeId, type])
  @@index([variantId])
  @@schema("shipping")
}

enum ShippingRuleType {
  METHOD
  RESTRICTION

  @@schema("shipping")
}

model ShipmentRate {
  id                String            @id
  fixedRate         Float
  description       String?
  calculationMethod CalculationMethod
  data              Json?
  shippingRuleId    String
  countryId         String
  stateId           String?
  storeId           String
  country           Country           @relation(fields: [countryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  state             State?            @relation(fields: [stateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  shippingRule      ShippingRule      @relation(fields: [shippingRuleId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  store             Store             @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([storeId, shippingRuleId, countryId, stateId], name: "unique_store_method_rate")
  @@index([storeId, shippingRuleId])
  @@index([countryId])
  @@index([stateId])
  @@schema("shipping")
}

enum CalculationMethod {
  FIXED
  WEIGHT
  VOLUME
  WEIGHT_AND_VOLUME

  @@schema("shipping")
}

// Product schema models
model TaxRate {
  id         String    @id
  rate       Float
  countryId  String
  stateId    String?
  categoryId String?
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  category   Category? @relation(fields: [categoryId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  country    Country   @relation(fields: [countryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  state      State?    @relation(fields: [stateId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([storeId, countryId, stateId, categoryId], name: "store_cannot_have_the_same_tax_rate_config")
  @@index([countryId])
  @@index([stateId])
  @@index([categoryId])
  @@schema("product")
}

model Category {
  id            String              @id
  name          String              @postgres.Citext
  cover         String
  description   String?
  subCategories Category[]          @relation("Subcategory")
  parentId      String?
  storeId       String
  updatedAt     DateTime            @updatedAt
  createdAt     DateTime            @default(now())
  taxRate       TaxRate[]
  products      ProductCategories[]
  parent        Category?           @relation("Subcategory", fields: [parentId, storeId], references: [id, storeId], onDelete: SetNull, onUpdate: NoAction)
  store         Store               @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([storeId, name])
  @@unique([id, storeId])
  @@index([parentId])
  @@schema("product")
}

model ProductCategories {
  id         String   @id
  productId  String
  categoryId String
  storeId    String
  product    Product  @relation(fields: [productId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  category   Category @relation(fields: [categoryId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([productId])
  @@index([categoryId])
  @@index([storeId])
  @@schema("product")
}

model Product {
  id               String              @id
  name             String              @postgres.Citext
  shortDescription String
  longDescription  String?             @postgres.Text
  productType      ProductType
  cover            String
  brand            String?
  manufacturer     String?
  tags             String[]
  isArchived       Boolean             @default(false)
  storeId          String
  updatedAt        DateTime            @updatedAt
  createdAt        DateTime            @default(now())
  media            Media[]
  variants         Variant[]
  categories       ProductCategories[]
  sustainabilities Sustainability[]
  store            Store               @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([storeId, name])
  @@unique([id, storeId])
  @@schema("product")
}

enum ProductType {
  PHYSICAL
  DIGITAL

  @@schema("product")
}

model Media {
  id        String    @id
  url       String
  position  Int
  mediaType MediaType
  productId String?
  variantId String?
  storeId   String
  product   Product?  @relation(fields: [productId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  Variant   Variant?  @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([productId, position])
  @@unique([variantId, position])
  @@index([storeId])
  @@schema("product")
}

enum MediaType {
  IMAGE
  VIDEO

  @@schema("product")
}

model InstallmentPayment {
  id           String  @id
  months       Int
  interestRate Float
  variantId    String
  variant      Variant @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([variantId])
  @@schema("product")
}

model Sustainability {
  id                 String  @id
  certification      String?
  recycledPercentage Float
  productId          String
  product            Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([productId])
  @@schema("product")
}

model Warranty {
  id           String  @id
  months       Int
  coverage     String
  instructions String
  variantId    String
  variant      Variant @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([variantId])
  @@schema("product")
}

model Variant {
  id                     String                  @id
  price                  Decimal                 @default(0)
  currency               String                  @default("GTQ")
  variantCover           String?
  personalizationOptions String[]
  weight                 Float?
  dimension              Dimension?
  condition              ProductCondition
  upc                    String?                 @unique
  ean                    String?                 @unique
  isbn                   String?                 @unique
  barcode                String?
  sku                    String                  @postgres.Citext
  isArchived             Boolean                 @default(false)
  productId              String
  storeId                String
  updatedAt              DateTime                @updatedAt
  createdAt              DateTime                @default(now())
  attributes             Attribute[]
  stockPerWarehouses     StockPerWarehouse[]
  variantMedia           Media[]
  installmentPayments    InstallmentPayment[]
  warranties             Warranty[]
  specificShippingRules  ShippingRule[]
  wishList               WishList[]
  returns                Return[]
  ordersDetails          OrderDetail[]
  customersReviews       CustomerReviewProduct[]
  cartItems              CartItem[]
  product                Product                 @relation(fields: [productId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  store                  Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([id, storeId])
  @@unique([storeId, sku])
  @@unique([storeId, barcode])
  @@index([productId])
  @@schema("product")
}

model Attribute {
  id        String  @id
  key       String
  value     String
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([variantId])
  @@schema("product")
}

model Dimension {
  id        String  @id
  length    Float
  width     Float
  height    Float
  variantId String  @unique
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@schema("product")
}

enum ProductCondition {
  NEW
  USED
  REFURBISHED

  @@schema("product")
}

// Pricing schema models
model Promotion {
  id              String               @id
  name            String               @postgres.Citext
  description     String
  type            PromotionType
  actionType      PromotionActionType?
  actionValue     Decimal?
  isStackable     Boolean              @default(false)
  params          Json
  priority        Int
  startDate       DateTime
  endDate         DateTime
  isArchived      Boolean              @default(false)
  updatedAt       DateTime             @updatedAt
  createdAt       DateTime             @default(now())
  storeId         String
  coupons         Coupon[]
  cartItems       CartItem[]
  orderPromotions OrderPromotions[]
  cartPromotions  CartPromotions[]
  store           Store                @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([storeId, name])
  @@unique([storeId, priority])
  @@unique([id, storeId])
  @@schema("pricing")
}

enum PromotionType {
  BUY_X_GET_DISCOUNT_ON_Y
  STORE_ATTRIBUTE
  PRODUCT_ATTRIBUTE
  BUY_X_GET_Y
  FIXED_GROUP
  COUPON
  BUNDLE

  @@schema("pricing")
}

enum PromotionActionType {
  PERCENTAGE
  FIXED

  @@schema("pricing")
}

model Coupon {
  id               String        @id
  code             String
  usageLimit       Int?
  perCustomerLimit Int           @default(1)
  usedCount        Int           @default(0)
  promotionId      String
  customerId       String?
  storeId          String
  updatedAt        DateTime      @updatedAt
  createdAt        DateTime      @default(now())
  couponUsages     CouponUsage[]
  promotion        Promotion     @relation(fields: [promotionId, storeId], references: [id, storeId])
  customer         Customer?     @relation(fields: [customerId, storeId], references: [id, storeId], onDelete: SetNull, onUpdate: Cascade)
  store            Store         @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([storeId, code])
  @@unique([id, storeId])
  @@index([promotionId])
  @@index([customerId])
  @@schema("pricing")
}

model CouponUsage {
  id       String   @id
  couponId String
  orderId  String
  storeId  String
  usedAt   DateTime @default(now())
  coupon   Coupon   @relation(fields: [couponId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  order    Order    @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  store    Store    @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([orderId, couponId])
  @@index([couponId])
  @@index([storeId])
  @@schema("pricing")
}

model CartPromotions {
  id          String    @id
  cartId      String
  promotionId String
  storeId     String
  cart        Cart      @relation(fields: [cartId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  promotion   Promotion @relation(fields: [promotionId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([cartId])
  @@index([promotionId])
  @@index([storeId])
  @@schema("pricing")
}

model OrderPromotions {
  id          String    @id
  orderId     String
  promotionId String
  storeId     String
  order       Order     @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Cascade)
  promotion   Promotion @relation(fields: [promotionId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Cascade)
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([orderId])
  @@index([promotionId])
  @@index([storeId])
  @@schema("pricing")
}

// Sales schema models
model Cart {
  id             String           @id
  customerId     String
  storeId        String
  cartItems      CartItem[]
  orders         Order[]
  customer       Customer         @relation(fields: [customerId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  store          Store            @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  CartPromotions CartPromotions[]

  @@unique([id, storeId])
  @@index([customerId])
  @@index([storeId])
  @@schema("sales")
}

model CartItem {
  id          String     @id
  qty         Int
  variantId   String
  cartId      String
  promotionId String?
  storeId     String
  updatedAt   DateTime   @updatedAt
  cart        Cart       @relation(fields: [cartId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  promotion   Promotion? @relation(fields: [promotionId, storeId], references: [id, storeId], onDelete: SetNull, onUpdate: Cascade)
  variant     Variant    @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  store       Store      @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([id, storeId])
  @@index([cartId])
  @@index([promotionId])
  @@index([variantId])
  @@index([storeId])
  @@schema("sales")
}

model Order {
  id              String            @id
  orderNumber     String
  status          OrderStatus
  totalAmount     Decimal
  customerId      String
  cartId          String
  addressId       String
  storeId         String
  updatedAt       DateTime          @updatedAt
  createdAt       DateTime          @default(now())
  orderDetails    OrderDetail[]
  returns         Return[]
  payments        Payment[]
  orderPromotions OrderPromotions[]
  couponUsages    CouponUsage[]
  customer        Customer          @relation(fields: [customerId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Cascade)
  cart            Cart              @relation(fields: [cartId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Cascade)
  address         Address           @relation(fields: [addressId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  store           Store             @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([storeId, orderNumber])
  @@unique([id, storeId])
  @@index([customerId])
  @@index([cartId])
  @@index([addressId])
  @@schema("sales")
}

enum OrderStatus {
  PROCESSING
  CONFIRMED
  SHIPPED
  COMPLETED
  CANCELLED

  @@schema("sales")
}

model OrderDetail {
  id          String   @id
  productName String
  qty         Int
  unitPrice   Decimal
  subtotal    Decimal
  orderId     String
  variantId   String
  storeId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       Order    @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Cascade)
  variant     Variant  @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Cascade)
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([orderId])
  @@index([variantId])
  @@index([storeId])
  @@schema("sales")
}

model Return {
  id           String   @id
  returnReason String   @postgres.Text
  refundAmount Decimal
  variantId    String
  orderId      String
  storeId      String
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
  order        Order    @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Cascade)
  variant      Variant  @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Cascade)
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([orderId])
  @@index([variantId])
  @@index([storeId])
  @@schema("sales")
}

model Payment {
  id              String        @id
  amount          Decimal
  status          Status
  transactionId   String?
  orderId         String
  paymentMethodId String
  subscriptionId  String
  storeId         String
  updatedAt       DateTime      @updatedAt
  createdAt       DateTime      @default(now())
  order           Order         @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Cascade)
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Cascade)
  Subscription    Subscription  @relation(fields: [subscriptionId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Cascade)
  store           Store         @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([orderId])
  @@index([paymentMethodId])
  @@index([subscriptionId])
  @@index([storeId])
  @@schema("sales")
}

enum Status {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED

  @@schema("sales")
}

model PaymentMethod {
  id                     String                  @id
  acceptedPaymentMethods AcceptedPaymentMethod[]
  storeId                String
  customerId             String?
  updatedAt              DateTime                @updatedAt
  createdAt              DateTime                @default(now())
  store                  Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  customer               Customer?               @relation(fields: [customerId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  payments               Payment[]

  @@unique([id, storeId])
  @@index([storeId])
  @@index([customerId])
  @@schema("sales")
}

enum AcceptedPaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  CASH
  BANK_TRANSFER
  PAYPAL
  PAYMENT_ON_DELIVERY
  INSTALLMENTS

  @@schema("sales")
}

// Customer schema models
model Customer {
  id                       String                  @id
  name                     String                  @postgres.Citext
  storeId                  String
  authIdentityId           String                  @unique
  defaultPhoneNumberId     String?                 @unique
  defaultShippingAddressId String?                 @unique
  defaultBillingAddressId  String?                 @unique
  updatedAt                DateTime                @updatedAt
  createdAt                DateTime                @default(now())
  wishLists                WishList[]
  customerReviewProducts   CustomerReviewProduct[]
  addresses                Address[]
  phoneNumbers             PhoneNumber[]
  coupons                  Coupon[]
  carts                    Cart[]
  orders                   Order[]
  paymentMethods           PaymentMethod[]
  store                    Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  authIdentity             AuthIdentity            @relation("CustomerAuth", fields: [authIdentityId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  defaultPhoneNumber       PhoneNumber?            @relation("CustomerDefaultPhone", fields: [defaultPhoneNumberId, id], references: [id, customerId], onDelete: Restrict, onUpdate: Cascade)
  defaultShippingAddress   Address?                @relation("CustomerDefaultShippingAddress", fields: [defaultShippingAddressId, id], references: [id, customerId], onDelete: Restrict, onUpdate: Cascade)
  defaultBillingAddress    Address?                @relation("CustomerDefaultBillingAddress", fields: [defaultBillingAddressId, id], references: [id, customerId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, storeId])
  @@unique([defaultPhoneNumberId, id])
  @@unique([defaultShippingAddressId, id])
  @@unique([defaultBillingAddressId, id])
  @@index([storeId])
  @@schema("customer")
}

model WishList {
  id         String   @id
  variantId  String
  customerId String
  storeId    String
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  variant    Variant  @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([customerId, variantId])
  @@unique([id, storeId])
  @@index([customerId])
  @@index([variantId])
  @@index([storeId])
  @@schema("customer")
}

model CustomerReviewProduct {
  id          String   @id
  ratingCount Float
  comment     String   @postgres.Text
  customerId  String
  variantId   String
  storeId     String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
  customer    Customer @relation(fields: [customerId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  variant     Variant  @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([id, storeId])
  @@index([customerId])
  @@index([variantId])
  @@index([storeId])
  @@schema("customer")
}

// Common schema models
model PhoneNumber {
  id                 String    @id
  number             String
  customerId         String?
  tenantId           String
  defaultForTenant   Tenant?   @relation("TenantDefaultPhone")
  defaultForCustomer Customer? @relation("CustomerDefaultPhone")
  customer           Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([id, tenantId])
  @@unique([id, customerId])
  @@index([customerId])
  @@index([tenantId])
  @@schema("common")
}

model Address {
  id                         String       @id
  name                       String       @postgres.Citext
  addressLine1               String
  addressLine2               String?
  postalCode                 String
  city                       String
  countryId                  String
  stateId                    String
  addressType                AddressTypes
  deliveryNum                String
  deliveryInstructions       String?
  tenantId                   String
  customerId                 String?
  warehouses                 Warehouse[]
  orders                     Order[]
  country                    Country      @relation(fields: [countryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  state                      State        @relation(fields: [stateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tenant                     Tenant       @relation(fields: [tenantId], references: [id])
  defaultShippingForTenant   Tenant?      @relation("TenantDefaultShippingAddress")
  defaultBillingForTenant    Tenant?      @relation("TenantDefaultBillingAddress")
  customer                   Customer?    @relation(fields: [customerId], references: [id])
  defaultShippingForCustomer Customer?    @relation("CustomerDefaultShippingAddress")
  defaultBillingForCustomer  Customer?    @relation("CustomerDefaultBillingAddress")

  @@unique([id, tenantId])
  @@unique([id, customerId])
  @@unique([tenantId, name])
  @@unique([customerId, name])
  @@index([countryId])
  @@index([stateId])
  @@schema("common")
}

enum AddressTypes {
  SHIPPING
  BILLING
  WAREHOUSE

  @@schema("common")
}

model AuthIdentity {
  id             String      @id
  email          String
  password       String
  accountType    AccountType
  isActive       Boolean     @default(true)
  emailVerified  Boolean     @default(false)
  lastLoginAt    DateTime?
  failedAttempts Int         @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  tenant         Tenant?     @relation("TenantAuth")
  customer       Customer?   @relation("CustomerAuth")
  employee       Employee?   @relation("EmployeeAuth")

  @@index([email, accountType])
  @@schema("common")
}

enum AccountType {
  TENANT
  CUSTOMER
  EMPLOYEE

  @@schema("common")
}

// Geography schema models
model Country {
  id             String         @id
  name           String         @unique @postgres.Citext
  code           String         @unique
  states         State[]
  addresses      Address[]
  taxRates       TaxRate[]
  shippmentRates ShipmentRate[]

  @@schema("geography")
}

model State {
  id             String         @id
  name           String         @postgres.Citext
  code           String
  countryId      String
  addresses      Address[]
  taxRates       TaxRate[]
  shippmentRates ShipmentRate[]
  country        Country        @relation(fields: [countryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([countryId])
  @@schema("geography")
}
