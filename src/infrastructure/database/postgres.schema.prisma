generator postgresClient {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/postgres"
}

datasource postgres {
  provider = "postgresql"
  url      = env("DATABASE_URL_POSTGRES")
  schemas  = ["tenant", "inventory", "product", "shipping", "pricing", "sales", "customer", "common", "geography"]
}

// Tenant schema models
model Tenant {
  id                       String        @id @default(uuid(7)) @postgres.Uuid
  name                     String
  authIdentityId           String        @unique @postgres.Uuid
  defaultStoreId           String?       @unique @postgres.Uuid
  defaultPhoneNumberId     String?       @unique @postgres.Uuid
  defaultShippingAddressId String?       @unique @postgres.Uuid
  defaultBillingAddressId  String?       @unique @postgres.Uuid
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  authIdentity             AuthIdentity  @relation("TenantAuth", fields: [authIdentityId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  stores                   Store[]       @relation("TenantStores")
  phoneNumbers             PhoneNumber[]
  addresses                Address[]
  defaultStore             Store?        @relation("TenantDefaultStore", fields: [defaultStoreId, id], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  defaultPhoneNumber       PhoneNumber?  @relation("TenantDefaultPhone", fields: [defaultPhoneNumberId, id], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  defaultShippingAddress   Address?      @relation("TenantDefaultShippingAddress", fields: [defaultShippingAddressId, id], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  defaultBillingAddress    Address?      @relation("TenantDefaultBillingAddress", fields: [defaultBillingAddressId, id], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([defaultStoreId, id])
  @@unique([defaultPhoneNumberId, id])
  @@unique([defaultShippingAddressId, id])
  @@unique([defaultBillingAddressId, id])
  @@schema("tenant")
}

model Store {
  id                     String                  @id @default(uuid(7)) @postgres.Uuid
  tenantId               String                  @postgres.Uuid
  name                   String?
  domain                 String?                 @unique
  logo                   String?
  description            String?                 @postgres.Text
  currency               Currency
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  tenant                 Tenant                  @relation("TenantStores", fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  defaultForTenant       Tenant?                 @relation("TenantDefaultStore")
  subscription           Subscription?
  roles                  EmployeeRole[]
  employees              Employee[]
  roleFeatures           RoleFeatures[]
  warehouses             Warehouse[]
  stockMovements         StockMovement[]
  stockPerWarehouses     StockPerWarehouse[]
  shippingRules          ShippingRule[]
  shippmentRates         ShipmentRate[]
  taxRates               TaxRate[]
  categories             Category[]
  productCategories      ProductCategories[]
  products               Product[]
  media                  Media[]
  variants               Variant[]
  promotions             Promotion[]
  coupons                Coupon[]
  couponUsages           CouponUsage[]
  cartPromotions         CartPromotions[]
  orderPromotions        OrderPromotions[]
  carts                  Cart[]
  cartItems              CartItem[]
  orders                 Order[]
  orderDetails           OrderDetail[]
  returns                Return[]
  payments               Payment[]
  paymentMethods         PaymentMethod[]
  customers              Customer[]
  wishLists              WishList[]
  customerReviewProducts CustomerReviewProduct[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@schema("tenant")
}

enum Currency {
  GTQ
  USD

  @@schema("tenant")
}

model Subscription {
  id        String             @id @default(uuid(7)) @postgres.Uuid
  status    SubscriptionStatus
  startDate DateTime
  endDate   DateTime
  planId    String             @postgres.Uuid
  storeId   String             @unique @postgres.Uuid
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  store     Store              @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  Plan      Plan               @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  payments  Payment[]

  @@unique([id, storeId])
  @@index([planId])
  @@schema("tenant")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED

  @@schema("tenant")
}

model Plan {
  id           String         @id @default(uuid(7)) @postgres.Uuid
  name         String         @unique @postgres.Citext
  description  String
  price        Decimal        @postgres.Decimal(19, 2)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  subscription Subscription[]

  @@schema("tenant")
}

model Employee {
  id             String          @id @default(uuid(7)) @postgres.Uuid
  name           String          @postgres.Citext
  roleId         String          @postgres.Uuid
  authIdentityId String          @unique @postgres.Uuid
  storeId        String          @postgres.Uuid
  role           EmployeeRole    @relation(fields: [roleId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Cascade)
  authIdentity   AuthIdentity    @relation("EmployeeAuth", fields: [authIdentityId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  store          Store           @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  StockMovement  StockMovement[]

  @@unique([id, storeId])
  @@index([roleId])
  @@index([storeId])
  @@schema("tenant")
}

model EmployeeRole {
  id           String         @id @default(uuid(7)) @postgres.Uuid
  role         String
  isSystem     Boolean        @default(false)
  storeId      String         @postgres.Uuid
  store        Store          @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  employees    Employee[]
  roleFeatures RoleFeatures[]

  @@unique([storeId, role])
  @@unique([id, storeId])
  @@index([storeId])
  @@schema("tenant")
}

model RoleFeatures {
  id           String           @id @default(uuid(7)) @postgres.Uuid
  roleId       String           @postgres.Uuid
  featureId    String           @postgres.Uuid
  action       PermissionAction
  storeId      String           @postgres.Uuid
  employeeRole EmployeeRole     @relation(fields: [roleId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  feature      Feature          @relation(fields: [featureId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  store        Store            @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([roleId, featureId, action])
  @@index([roleId])
  @@index([featureId])
  @@index([storeId])
  @@schema("tenant")
}

enum PermissionAction {
  VIEW
  CREATE
  EDIT
  DELETE

  @@schema("tenant")
}

model Feature {
  id           String         @id @default(uuid(7)) @postgres.Uuid
  code         String         @unique
  name         String         @postgres.Citext
  description  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  roleFeatures RoleFeatures[]

  @@schema("tenant")
}

// Inventory schema models
model Warehouse {
  id                 String              @id @default(uuid(7)) @postgres.Uuid
  name               String              @postgres.Citext
  addressId          String              @postgres.Uuid
  storeId            String              @postgres.Uuid
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  store              Store               @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  address            Address             @relation(fields: [addressId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  stockMovements     StockMovement[]
  stockPerWarehouses StockPerWarehouse[]

  @@unique([id, storeId])
  @@unique([storeId, name])
  @@unique([storeId, addressId])
  @@index([addressId])
  @@schema("inventory")
}

model StockMovement {
  id                  String            @id @default(uuid(7)) @postgres.Uuid
  deltaQty            Int
  reason              String            @postgres.Text
  createdById         String?           @postgres.Uuid
  warehouseId         String            @postgres.Uuid
  stockPerWarehouseId String            @postgres.Uuid
  storeId             String            @postgres.Uuid
  occurredAt          DateTime          @default(now())
  warehouse           Warehouse         @relation(fields: [warehouseId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  createdBy           Employee?         @relation(fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  StockPerWarehouse   StockPerWarehouse @relation(fields: [stockPerWarehouseId, storeId], references: [id, storeId])
  store               Store             @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([createdById])
  @@index([warehouseId])
  @@index([stockPerWarehouseId])
  @@index([storeId])
  @@schema("inventory")
}

model StockPerWarehouse {
  id                         String          @id @default(uuid(7)) @postgres.Uuid
  qtyAvailable               Int             @default(0)
  qtyReserved                Int             @default(0)
  productLocation            String?
  estimatedReplenishmentDate DateTime?
  lotNumber                  String?
  serialNumbers              String[]
  variantId                  String          @postgres.Uuid
  warehouseId                String          @postgres.Uuid
  storeId                    String          @postgres.Uuid
  deletedAt                  DateTime?
  stockMovements             StockMovement[]
  variant                    Variant         @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  warehouse                  Warehouse       @relation(fields: [warehouseId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  store                      Store           @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([warehouseId, variantId, storeId])
  @@unique([id, storeId])
  @@index([variantId])
  @@index([storeId])
  @@schema("inventory")
}

// Shipping schema models
model ShippingRule {
  id             String           @id @default(uuid(7)) @postgres.Uuid
  type           ShippingRuleType
  slug           String
  description    String
  isEnabled      Boolean          @default(true)
  priority       Int?
  conditions     Json?
  storeId        String           @postgres.Uuid
  variantId      String?          @postgres.Uuid
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  shippmentRates ShipmentRate[]
  store          Store            @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  variant        Variant?         @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)

  @@unique([storeId, slug])
  @@unique([storeId, priority])
  @@unique([id, storeId])
  @@index([storeId, type])
  @@index([variantId])
  @@schema("shipping")
}

enum ShippingRuleType {
  METHOD
  RESTRICTION

  @@schema("shipping")
}

model ShipmentRate {
  id                String            @id @default(uuid(7)) @postgres.Uuid
  fixedRate         Float
  description       String?
  calculationMethod CalculationMethod
  data              Json?
  shippingRuleId    String            @postgres.Uuid
  countryId         String            @postgres.Uuid
  stateId           String?           @postgres.Uuid
  storeId           String            @postgres.Uuid
  country           Country           @relation(fields: [countryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  state             State?            @relation(fields: [stateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  shippingRule      ShippingRule      @relation(fields: [shippingRuleId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  store             Store             @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([storeId, shippingRuleId, countryId, stateId], name: "unique_store_method_rate")
  @@index([storeId, shippingRuleId])
  @@index([countryId])
  @@index([stateId])
  @@schema("shipping")
}

enum CalculationMethod {
  FIXED
  WEIGHT
  VOLUME
  WEIGHT_AND_VOLUME

  @@schema("shipping")
}

// Product schema models
model TaxRate {
  id         String    @id @default(uuid(7)) @postgres.Uuid
  rate       Float
  countryId  String    @postgres.Uuid
  stateId    String?   @postgres.Uuid
  categoryId String?   @postgres.Uuid
  storeId    String    @postgres.Uuid
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  category   Category? @relation(fields: [categoryId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  country    Country   @relation(fields: [countryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  state      State?    @relation(fields: [stateId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([storeId, countryId, stateId, categoryId], name: "store_cannot_have_the_same_tax_rate_config")
  @@index([countryId])
  @@index([stateId])
  @@index([categoryId])
  @@schema("product")
}

model Category {
  id            String              @id @default(uuid(7)) @postgres.Uuid
  name          String              @postgres.Citext
  cover         String
  description   String?
  subCategories Category[]          @relation("Subcategory")
  parentId      String?             @postgres.Uuid
  storeId       String              @postgres.Uuid
  updatedAt     DateTime            @updatedAt
  createdAt     DateTime            @default(now())
  taxRate       TaxRate[]
  products      ProductCategories[]
  parent        Category?           @relation("Subcategory", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  store         Store               @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([storeId, name])
  @@unique([id, storeId])
  @@index([parentId])
  @@schema("product")
}

model ProductCategories {
  id         String   @id @default(uuid(7)) @postgres.Uuid
  productId  String   @postgres.Uuid
  categoryId String   @postgres.Uuid
  storeId    String   @postgres.Uuid
  product    Product  @relation(fields: [productId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  category   Category @relation(fields: [categoryId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([productId])
  @@index([categoryId])
  @@index([storeId])
  @@schema("product")
}

model Product {
  id               String              @id @default(uuid(7)) @postgres.Uuid
  name             String              @postgres.Citext
  shortDescription String
  longDescription  String?             @postgres.Text
  productType      ProductType
  currency         Currency
  cover            String
  brand            String?
  manufacturer     String?
  tags             String[]
  isArchived       Boolean             @default(false)
  storeId          String              @postgres.Uuid
  updatedAt        DateTime            @updatedAt
  createdAt        DateTime            @default(now())
  media            Media[]
  variants         Variant[]
  categories       ProductCategories[]
  sustainabilities Sustainability[]
  store            Store               @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([storeId, name])
  @@unique([id, storeId])
  @@schema("product")
}

enum ProductType {
  PHYSICAL
  DIGITAL

  @@schema("product")
}

model Media {
  id        String    @id @default(uuid(7)) @postgres.Uuid
  url       String
  position  Int
  mediaType MediaType
  productId String?   @postgres.Uuid
  variantId String?   @postgres.Uuid
  storeId   String    @postgres.Uuid
  product   Product?  @relation(fields: [productId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  Variant   Variant?  @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([productId, position])
  @@unique([variantId, position])
  @@index([storeId])
  @@schema("product")
}

enum MediaType {
  IMAGE
  VIDEO

  @@schema("product")
}

model InstallmentPayment {
  id           String  @id @default(uuid(7)) @postgres.Uuid
  months       Int
  interestRate Float
  variantId    String  @postgres.Uuid
  variant      Variant @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([variantId])
  @@schema("product")
}

model Sustainability {
  id                 String  @id @default(uuid(7)) @postgres.Uuid
  certification      String?
  recycledPercentage Float
  productId          String  @postgres.Uuid
  product            Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([productId])
  @@schema("product")
}

model Warranty {
  id           String  @id @default(uuid(7)) @postgres.Uuid
  months       Int
  coverage     String
  instructions String
  variantId    String  @postgres.Uuid
  variant      Variant @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([variantId])
  @@schema("product")
}

model Variant {
  id                     String                  @id @default(uuid(7)) @postgres.Uuid
  price                  Decimal                 @default(0) @postgres.Decimal(19, 2)
  variantCover           String?
  personalizationOptions String[]
  weight                 Float?
  dimension              Dimension?
  condition              ProductCondition
  upc                    String?                 @unique
  ean                    String?                 @unique
  isbn                   String?                 @unique
  barcode                String?
  sku                    String                  @postgres.Citext
  isArchived             Boolean                 @default(false)
  productId              String                  @postgres.Uuid
  storeId                String                  @postgres.Uuid
  updatedAt              DateTime                @updatedAt
  createdAt              DateTime                @default(now())
  attributes             Attribute[]
  stockPerWarehouses     StockPerWarehouse[]
  variantMedia           Media[]
  installmentPayments    InstallmentPayment[]
  warranties             Warranty[]
  specificShippingRules  ShippingRule[]
  wishList               WishList[]
  returns                Return[]
  ordersDetails          OrderDetail[]
  customersReviews       CustomerReviewProduct[]
  cartItems              CartItem[]
  product                Product                 @relation(fields: [productId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  store                  Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([id, storeId])
  @@unique([storeId, sku])
  @@unique([storeId, barcode])
  @@index([productId])
  @@schema("product")
}

model Attribute {
  id        String  @id @default(uuid(7)) @postgres.Uuid
  key       String
  value     String
  variantId String  @postgres.Uuid
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([variantId])
  @@schema("product")
}

model Dimension {
  id        String  @id @default(uuid(7)) @postgres.Uuid
  length    Float
  width     Float
  height    Float
  variantId String  @unique @postgres.Uuid
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@schema("product")
}

enum ProductCondition {
  NEW
  USED
  REFURBISHED

  @@schema("product")
}

// Pricing schema models
model Promotion {
  id              String               @id @default(uuid(7)) @postgres.Uuid
  name            String               @postgres.Citext
  description     String
  type            PromotionType
  actionType      PromotionActionType?
  actionValue     Decimal?             @postgres.Decimal(19, 2)
  isStackable     Boolean              @default(false)
  params          Json
  priority        Int
  startDate       DateTime
  endDate         DateTime
  isArchived      Boolean              @default(false)
  updatedAt       DateTime             @updatedAt
  createdAt       DateTime             @default(now())
  storeId         String               @postgres.Uuid
  coupons         Coupon[]
  cartItems       CartItem[]
  orderPromotions OrderPromotions[]
  cartPromotions  CartPromotions[]
  store           Store                @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([storeId, name])
  @@unique([storeId, priority])
  @@unique([id, storeId])
  @@schema("pricing")
}

enum PromotionType {
  BUY_X_GET_DISCOUNT_ON_Y
  STORE_ATTRIBUTE
  PRODUCT_ATTRIBUTE
  BUY_X_GET_Y
  FIXED_GROUP
  COUPON
  BUNDLE

  @@schema("pricing")
}

enum PromotionActionType {
  PERCENTAGE
  FIXED

  @@schema("pricing")
}

model Coupon {
  id               String        @id @default(uuid(7)) @postgres.Uuid
  code             String
  usageLimit       Int?
  perCustomerLimit Int           @default(1)
  usedCount        Int           @default(0)
  promotionId      String        @postgres.Uuid
  customerId       String?       @postgres.Uuid
  storeId          String        @postgres.Uuid
  updatedAt        DateTime      @updatedAt
  createdAt        DateTime      @default(now())
  couponUsages     CouponUsage[]
  promotion        Promotion     @relation(fields: [promotionId, storeId], references: [id, storeId])
  customer         Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  store            Store         @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([storeId, code])
  @@unique([id, storeId])
  @@index([promotionId])
  @@index([customerId])
  @@schema("pricing")
}

model CouponUsage {
  id       String   @id @default(uuid(7)) @postgres.Uuid
  couponId String   @postgres.Uuid
  orderId  String   @postgres.Uuid
  storeId  String   @postgres.Uuid
  usedAt   DateTime @default(now())
  coupon   Coupon   @relation(fields: [couponId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  order    Order    @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  store    Store    @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([orderId, couponId])
  @@index([couponId])
  @@index([storeId])
  @@schema("pricing")
}

model CartPromotions {
  id          String    @id @default(uuid(7)) @postgres.Uuid
  cartId      String    @postgres.Uuid
  promotionId String    @postgres.Uuid
  storeId     String    @postgres.Uuid
  cart        Cart      @relation(fields: [cartId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  promotion   Promotion @relation(fields: [promotionId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([cartId])
  @@index([promotionId])
  @@index([storeId])
  @@schema("pricing")
}

model OrderPromotions {
  id          String    @id @default(uuid(7)) @postgres.Uuid
  orderId     String    @postgres.Uuid
  promotionId String    @postgres.Uuid
  storeId     String    @postgres.Uuid
  order       Order     @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Cascade)
  promotion   Promotion @relation(fields: [promotionId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Cascade)
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([orderId])
  @@index([promotionId])
  @@index([storeId])
  @@schema("pricing")
}

// Sales schema models
model Cart {
  id             String           @id @default(uuid(7)) @postgres.Uuid
  customerId     String           @postgres.Uuid
  storeId        String           @postgres.Uuid
  cartItems      CartItem[]
  orders         Order[]
  customer       Customer         @relation(fields: [customerId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  store          Store            @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  CartPromotions CartPromotions[]

  @@unique([id, storeId])
  @@index([customerId])
  @@index([storeId])
  @@schema("sales")
}

model CartItem {
  id          String     @id @default(uuid(7)) @postgres.Uuid
  qty         Int
  variantId   String     @postgres.Uuid
  cartId      String     @postgres.Uuid
  promotionId String?    @postgres.Uuid
  storeId     String     @postgres.Uuid
  updatedAt   DateTime   @updatedAt
  cart        Cart       @relation(fields: [cartId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  promotion   Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  variant     Variant    @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  store       Store      @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([id, storeId])
  @@index([cartId])
  @@index([promotionId])
  @@index([variantId])
  @@index([storeId])
  @@schema("sales")
}

model Order {
  id              String            @id @default(uuid(7)) @postgres.Uuid
  orderNumber     String
  status          OrderStatus
  totalAmount     Decimal           @postgres.Decimal(19, 2)
  currency        Currency
  customerId      String            @postgres.Uuid
  cartId          String            @postgres.Uuid
  addressId       String            @postgres.Uuid
  storeId         String            @postgres.Uuid
  updatedAt       DateTime          @updatedAt
  createdAt       DateTime          @default(now())
  orderDetails    OrderDetail[]
  returns         Return[]
  payments        Payment[]
  orderPromotions OrderPromotions[]
  couponUsages    CouponUsage[]
  customer        Customer          @relation(fields: [customerId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Cascade)
  cart            Cart              @relation(fields: [cartId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Cascade)
  address         Address           @relation(fields: [addressId, customerId], references: [id, customerId], onDelete: Restrict, onUpdate: Cascade)
  store           Store             @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([storeId, orderNumber])
  @@unique([id, storeId])
  @@index([customerId])
  @@index([cartId])
  @@index([addressId])
  @@schema("sales")
}

enum OrderStatus {
  PROCESSING
  CONFIRMED
  SHIPPED
  COMPLETED
  CANCELLED

  @@schema("sales")
}

model OrderDetail {
  id          String   @id @default(uuid(7)) @postgres.Uuid
  productName String
  qty         Int
  unitPrice   Decimal  @postgres.Decimal(19, 2)
  subtotal    Decimal  @postgres.Decimal(19, 2)
  orderId     String   @postgres.Uuid
  variantId   String   @postgres.Uuid
  storeId     String   @postgres.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       Order    @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Cascade)
  variant     Variant  @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Cascade)
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([orderId])
  @@index([variantId])
  @@index([storeId])
  @@schema("sales")
}

model Return {
  id           String   @id @default(uuid(7)) @postgres.Uuid
  returnReason String   @postgres.Text
  refundAmount Decimal  @postgres.Decimal(19, 2)
  variantId    String   @postgres.Uuid
  orderId      String   @postgres.Uuid
  storeId      String   @postgres.Uuid
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
  order        Order    @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Cascade)
  variant      Variant  @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Cascade)
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([orderId])
  @@index([variantId])
  @@index([storeId])
  @@schema("sales")
}

model Payment {
  id              String        @id @default(uuid(7)) @postgres.Uuid
  amount          Decimal       @postgres.Decimal(19, 2)
  status          Status
  transactionId   String?
  orderId         String        @postgres.Uuid
  paymentMethodId String        @postgres.Uuid
  subscriptionId  String        @postgres.Uuid
  storeId         String        @postgres.Uuid
  updatedAt       DateTime      @updatedAt
  createdAt       DateTime      @default(now())
  order           Order         @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Cascade)
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Cascade)
  Subscription    Subscription  @relation(fields: [subscriptionId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Cascade)
  store           Store         @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([orderId])
  @@index([paymentMethodId])
  @@index([subscriptionId])
  @@index([storeId])
  @@schema("sales")
}

enum Status {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED

  @@schema("sales")
}

model PaymentMethod {
  id                     String                  @id @default(uuid(7)) @postgres.Uuid
  acceptedPaymentMethods AcceptedPaymentMethod[]
  storeId                String                  @postgres.Uuid
  customerId             String?                 @postgres.Uuid
  updatedAt              DateTime                @updatedAt
  createdAt              DateTime                @default(now())
  store                  Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  customer               Customer?               @relation(fields: [customerId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  payments               Payment[]

  @@unique([id, storeId])
  @@index([storeId])
  @@index([customerId])
  @@schema("sales")
}

enum AcceptedPaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  CASH
  BANK_TRANSFER
  PAYPAL
  PAYMENT_ON_DELIVERY
  INSTALLMENTS

  @@schema("sales")
}

// Customer schema models
model Customer {
  id                       String                  @id @default(uuid(7)) @postgres.Uuid
  name                     String                  @postgres.Citext
  storeId                  String                  @postgres.Uuid
  authIdentityId           String                  @unique @postgres.Uuid
  defaultPhoneNumberId     String?                 @unique @postgres.Uuid
  defaultShippingAddressId String?                 @unique @postgres.Uuid
  defaultBillingAddressId  String?                 @unique @postgres.Uuid
  updatedAt                DateTime                @updatedAt
  createdAt                DateTime                @default(now())
  wishLists                WishList[]
  customerReviewProducts   CustomerReviewProduct[]
  addresses                Address[]
  phoneNumbers             PhoneNumber[]
  coupons                  Coupon[]
  carts                    Cart[]
  orders                   Order[]
  paymentMethods           PaymentMethod[]
  store                    Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  authIdentity             AuthIdentity            @relation("CustomerAuth", fields: [authIdentityId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  defaultPhoneNumber       PhoneNumber?            @relation("CustomerDefaultPhone", fields: [defaultPhoneNumberId, id], references: [id, customerId], onDelete: Restrict, onUpdate: Cascade)
  defaultShippingAddress   Address?                @relation("CustomerDefaultShippingAddress", fields: [defaultShippingAddressId, id], references: [id, customerId], onDelete: Restrict, onUpdate: Cascade)
  defaultBillingAddress    Address?                @relation("CustomerDefaultBillingAddress", fields: [defaultBillingAddressId, id], references: [id, customerId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, storeId])
  @@unique([defaultPhoneNumberId, id])
  @@unique([defaultShippingAddressId, id])
  @@unique([defaultBillingAddressId, id])
  @@index([storeId])
  @@schema("customer")
}

model WishList {
  id         String   @id @default(uuid(7)) @postgres.Uuid
  variantId  String   @postgres.Uuid
  customerId String   @postgres.Uuid
  storeId    String   @postgres.Uuid
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  variant    Variant  @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([customerId, variantId])
  @@unique([id, storeId])
  @@index([customerId])
  @@index([variantId])
  @@index([storeId])
  @@schema("customer")
}

model CustomerReviewProduct {
  id          String   @id @default(uuid(7)) @postgres.Uuid
  ratingCount Float
  comment     String   @postgres.Text
  customerId  String   @postgres.Uuid
  variantId   String   @postgres.Uuid
  storeId     String   @postgres.Uuid
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
  customer    Customer @relation(fields: [customerId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  variant     Variant  @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Cascade)
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([id, storeId])
  @@index([customerId])
  @@index([variantId])
  @@index([storeId])
  @@schema("customer")
}

// Common schema models
model PhoneNumber {
  id                 String    @id @default(uuid(7)) @postgres.Uuid
  number             String
  customerId         String?   @postgres.Uuid
  tenantId           String    @postgres.Uuid
  defaultForTenant   Tenant?   @relation("TenantDefaultPhone")
  defaultForCustomer Customer? @relation("CustomerDefaultPhone")
  customer           Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([id, tenantId])
  @@unique([id, customerId])
  @@index([customerId])
  @@index([tenantId])
  @@schema("common")
}

model Address {
  id                         String       @id @default(uuid(7)) @postgres.Uuid
  name                       String       @postgres.Citext
  addressLine1               String
  addressLine2               String?
  postalCode                 String
  city                       String
  countryId                  String       @postgres.Uuid
  stateId                    String       @postgres.Uuid
  addressType                AddressTypes
  deliveryNum                String
  deliveryInstructions       String?
  tenantId                   String       @postgres.Uuid
  customerId                 String?      @postgres.Uuid
  warehouses                 Warehouse[]
  orders                     Order[]
  country                    Country      @relation(fields: [countryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  state                      State        @relation(fields: [stateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tenant                     Tenant       @relation(fields: [tenantId], references: [id])
  defaultShippingForTenant   Tenant?      @relation("TenantDefaultShippingAddress")
  defaultBillingForTenant    Tenant?      @relation("TenantDefaultBillingAddress")
  customer                   Customer?    @relation(fields: [customerId], references: [id])
  defaultShippingForCustomer Customer?    @relation("CustomerDefaultShippingAddress")
  defaultBillingForCustomer  Customer?    @relation("CustomerDefaultBillingAddress")

  @@unique([id, tenantId])
  @@unique([id, customerId])
  @@unique([tenantId, name])
  @@unique([customerId, name])
  @@index([countryId])
  @@index([stateId])
  @@schema("common")
}

enum AddressTypes {
  SHIPPING
  BILLING
  WAREHOUSE

  @@schema("common")
}

model AuthIdentity {
  id             String      @id @default(uuid(7)) @postgres.Uuid
  email          String
  password       String
  accountType    AccountType
  isActive       Boolean     @default(true)
  emailVerified  Boolean     @default(false)
  lastLoginAt    DateTime?
  failedAttempts Int         @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  tenant         Tenant?     @relation("TenantAuth")
  customer       Customer?   @relation("CustomerAuth")
  employee       Employee?   @relation("EmployeeAuth")

  @@index([email, accountType])
  @@schema("common")
}

enum AccountType {
  TENANT
  CUSTOMER
  EMPLOYEE

  @@schema("common")
}

// Geography schema models
model Country {
  id             String         @id @default(uuid(7)) @postgres.Uuid
  name           String         @unique @postgres.Citext
  code           String         @unique
  states         State[]
  addresses      Address[]
  taxRates       TaxRate[]
  shippmentRates ShipmentRate[]

  @@schema("geography")
}

model State {
  id             String         @id @default(uuid(7)) @postgres.Uuid
  name           String         @postgres.Citext
  code           String
  countryId      String         @postgres.Uuid
  addresses      Address[]
  taxRates       TaxRate[]
  shippmentRates ShipmentRate[]
  country        Country        @relation(fields: [countryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([countryId])
  @@schema("geography")
}
