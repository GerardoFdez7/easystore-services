{
  "name": "easystore-services",
  "version": "0.0.1",
  "description": "Backend project of EasyStore, the web application that empowers you to build your own e-commerce platform without any programming knowledge. This user-friendly solution provides all the tools you need to create, manage, and grow your online store with ease.",
  "author": "EasyStore Team",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "build": "npx nest build",
    "start": "node dist/src/main.js",
    "prod": "npx nest build && node dist/src/main.js",
    "dev": "npx nest start --watch",
    "debug": "npx nest start --debug --watch",
    "docker": "set npm_config_ignore_scripts=true && docker-compose -f docker-compose.dev.yml up",
    "studio": "set PRISMA_HIDE_UPDATE_MESSAGE=1 && npx prisma studio --schema src/infrastructure/database/postgres.schema.prisma",
    "generate": "prisma generate --schema src/infrastructure/database/postgres.schema.prisma",
    "dbpush": "set PRISMA_HIDE_UPDATE_MESSAGE=1 && npx prisma db push --schema src/infrastructure/database/postgres.schema.prisma",
    "seed": "npx ts-node src/infrastructure/database/seed.ts",
    "database": "set PRISMA_HIDE_UPDATE_MESSAGE=1 && npx prisma migrate dev --schema src/infrastructure/database/postgres.schema.prisma && npm run seed",
    "architecture": "npm run architecture:structure && npm run architecture:semgrep",
    "architecture:structure": "node tools/check-architecture.mjs",
    "architecture:semgrep": "semgrep scan --config .semgrep.yml --error src/domains",
    "duplication": "jscpd --config .jscpd.json",
    "lint": "eslint",
    "lint:fix": "prettier --write \"src/**/*.{ts,js,json}\" \"test/**/*.{ts,js,json}\" \"*.{ts,js,json}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "postinstall": "npm run generate",
    "prepare": "is-ci || node -e \"if(process.env.NODE_ENV!=='production'){process.exit(1)}\" || husky install"
  },
  "dependencies": {
    "@as-integrations/express5": "1.1.2",
    "@nestjs/apollo": "13.0.4",
    "@nestjs/common": "11.0.20",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.0.12",
    "@nestjs/cqrs": "11.0.3",
    "@nestjs/graphql": "13.0.4",
    "@nestjs/microservices": "11.0.20",
    "@nestjs/platform-express": "11.1.3",
    "@nestjs/schedule": "6.0.0",
    "@nestjs/terminus": "11.0.0",
    "@prisma/client": "6.14.0",
    "@types/bcrypt": "5.0.2",
    "bcrypt": "5.1.1",
    "compression": "1.8.0",
    "cookie-parser": "1.4.7",
    "graphql": "16.11.0",
    "helmet": "8.1.0",
    "imagekit": "6.0.0",
    "jsonwebtoken": "9.0.2",
    "nestjs-pino": "4.4.1",
    "pino": "9.0.0",
    "pino-http": "10.5.0",
    "resend": "4.7.0",
    "uuid": "11.1.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3",
    "@eslint/js": "9.0.0",
    "@mermaid-js/mermaid-cli": "11.4.2",
    "@nestjs/cli": "10.0.0",
    "@nestjs/schematics": "10.0.0",
    "@nestjs/testing": "11.0.12",
    "@types/compression": "1.7.5",
    "@types/cookie-parser": "1.4.9",
    "@types/helmet": "0.0.48",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.9",
    "@types/node": "24",
    "@types/supertest": "2.0.12",
    "@typescript-eslint/eslint-plugin": "8.28.0",
    "@typescript-eslint/parser": "8.28.0",
    "eslint": "9",
    "eslint-config-prettier": "10.1.1",
    "eslint-plugin-prettier": "5.2.5",
    "husky": "8.0.0",
    "jest": "29.7.0",
    "jscpd": "5.0.15",
    "lint-staged": "15.5.0",
    "pino-pretty": "13.1.1",
    "prettier": "3.5.3",
    "prettier-plugin-prisma": "5.0.0",
    "prisma": "6.14.0",
    "prisma-erd-generator": "2.0.4",
    "source-map-support": "0.5.21",
    "supertest": "6.3.3",
    "ts-jest": "29.4.0",
    "ts-loader": "9.4.3",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.1.3"
  }
}
